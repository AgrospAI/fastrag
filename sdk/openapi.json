{
  "components": {
    "schemas": {
      "ApiErrorCode": {
        "enum": [
          "UNAUTHORIZED",
          "NOT_FOUND",
          "CONFLICT",
          "PAYLOAD_TOO_LARGE",
          "UNSUPPORTED_MEDIA_TYPE",
          "RATE_LIMIT",
          "INVALID_REQUEST",
          "INTERNAL_ERROR"
        ],
        "title": "ApiErrorCode",
        "type": "string"
      },
      "ApiErrorEnvelope": {
        "description": "The ``{\"error\": {\"code\", \"message\"}}`` body of a request-level failure.\n\nRaised as a ``4xx``/``5xx`` before a generation's stream opens. Never\nreturned through FastAPI's response-model validation \u2014 the\nexception handlers in ``_errors.py`` build this exact shape by hand as a\nplain dict, since a ``BaseHTTPMiddleware``/exception-handler response\nbypasses per-route ``response_model`` machinery. This model exists only\nso the shape still has a name in the OpenAPI document: it is attached to\nevery ``/v1`` route via ``include_router(responses=...)`` in ``app.py``.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ApiErrorInfo"
          }
        },
        "required": [
          "error"
        ],
        "title": "ApiErrorEnvelope",
        "type": "object"
      },
      "ApiErrorInfo": {
        "description": "A request-level failure's outcome \u2014 ``code`` is one of :data:`ApiErrorCode`.",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ApiErrorCode"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ApiErrorInfo",
        "type": "object"
      },
      "ChatListResponse": {
        "properties": {
          "chats": {
            "items": {
              "$ref": "#/components/schemas/ChatSummary"
            },
            "title": "Chats",
            "type": "array"
          },
          "first_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "First Id"
          },
          "has_more": {
            "title": "Has More",
            "type": "boolean"
          },
          "last_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Id"
          }
        },
        "required": [
          "first_id",
          "last_id",
          "has_more",
          "chats"
        ],
        "title": "ChatListResponse",
        "type": "object"
      },
      "ChatSummary": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "created_at"
        ],
        "title": "ChatSummary",
        "type": "object"
      },
      "ContentRequest": {
        "description": "``POST /v1/chats`` and ``POST /v1/chats/{chat_id}/messages`` body.",
        "properties": {
          "content": {
            "title": "Content",
            "type": "string"
          }
        },
        "required": [
          "content"
        ],
        "title": "ContentRequest",
        "type": "object"
      },
      "DeltaEvent": {
        "description": "Payload of the SSE ``delta`` event.",
        "properties": {
          "delta": {
            "$ref": "#/components/schemas/TextDelta"
          },
          "message_id": {
            "title": "Message Id",
            "type": "string"
          }
        },
        "required": [
          "message_id",
          "delta"
        ],
        "title": "DeltaEvent",
        "type": "object"
      },
      "ErrorCode": {
        "enum": [
          "MODEL_ERROR",
          "TIMEOUT",
          "RATE_LIMIT",
          "CONTEXT_TOO_LONG",
          "NETWORK_ERROR",
          "SERVICE_UNAVAILABLE",
          "INVALID_REQUEST",
          "INVALID_RESPONSE",
          "INTERNAL_ERROR"
        ],
        "title": "ErrorCode",
        "type": "string"
      },
      "ErrorInfo": {
        "description": "A failed *generation*'s outcome \u2014 ``code`` is one of :data:`ErrorCode`.",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorInfo",
        "type": "object"
      },
      "FinishReason": {
        "enum": [
          "stop",
          "length",
          "error",
          "interrupted"
        ],
        "title": "FinishReason",
        "type": "string"
      },
      "MessageEndEvent": {
        "description": "Payload of the SSE ``message_end`` event.\n\n``error`` is present only when ``finish_reason == \"error\"`` \u2014 omitted\nfrom the wire frame entirely otherwise, not sent as ``null``\n(``_generation.py`` dumps this with ``exclude_none=True``).",
        "properties": {
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ErrorInfo"
              },
              {
                "type": "null"
              }
            ]
          },
          "finish_reason": {
            "$ref": "#/components/schemas/FinishReason"
          },
          "message_id": {
            "title": "Message Id",
            "type": "string"
          }
        },
        "required": [
          "message_id",
          "finish_reason"
        ],
        "title": "MessageEndEvent",
        "type": "object"
      },
      "MessageListResponse": {
        "properties": {
          "first_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "First Id"
          },
          "has_more": {
            "title": "Has More",
            "type": "boolean"
          },
          "last_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Id"
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/MessageResponse"
            },
            "title": "Messages",
            "type": "array"
          }
        },
        "required": [
          "first_id",
          "last_id",
          "has_more",
          "messages"
        ],
        "title": "MessageListResponse",
        "type": "object"
      },
      "MessageResponse": {
        "properties": {
          "content": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content"
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ErrorInfo"
              },
              {
                "type": "null"
              }
            ]
          },
          "finish_reason": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/FinishReason"
              },
              {
                "type": "null"
              }
            ]
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/MessageRole"
          },
          "sources": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/Source"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sources"
          }
        },
        "required": [
          "id",
          "role",
          "content"
        ],
        "title": "MessageResponse",
        "type": "object"
      },
      "MessageRole": {
        "enum": [
          "user",
          "assistant",
          "system"
        ],
        "title": "MessageRole",
        "type": "string"
      },
      "MessageStartEvent": {
        "description": "Payload of the SSE ``message_start`` event \u2014 see ``streaming.md``.",
        "properties": {
          "chat_id": {
            "title": "Chat Id",
            "type": "string"
          },
          "message_id": {
            "title": "Message Id",
            "type": "string"
          },
          "user_message_id": {
            "title": "User Message Id",
            "type": "string"
          }
        },
        "required": [
          "chat_id",
          "user_message_id",
          "message_id"
        ],
        "title": "MessageStartEvent",
        "type": "object"
      },
      "OptionalContentRequest": {
        "description": "``POST /v1/chats/{chat_id}/messages/{message_id}`` body.\n\n``content`` is only meaningful when the target message is a ``user``\nmessage \u2014 rejected with ``422`` when the target is ``assistant`` (checked\nin the route).",
        "properties": {
          "content": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content"
          }
        },
        "title": "OptionalContentRequest",
        "type": "object"
      },
      "SessionResponse": {
        "properties": {
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "session_id": {
            "title": "Session Id",
            "type": "string"
          }
        },
        "required": [
          "session_id",
          "expires_at"
        ],
        "title": "SessionResponse",
        "type": "object"
      },
      "Source": {
        "description": "One retrieved page an answer may cite, deduplicated by ``url``.",
        "properties": {
          "favicon_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Favicon Url"
          },
          "fragments": {
            "items": {
              "$ref": "#/components/schemas/TextFragment"
            },
            "title": "Fragments",
            "type": "array"
          },
          "positions": {
            "items": {
              "type": "integer"
            },
            "title": "Positions",
            "type": "array"
          },
          "site_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Site Name"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "url": {
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url",
          "title"
        ],
        "title": "Source",
        "type": "object"
      },
      "SourcesEvent": {
        "description": "Payload of the SSE ``sources`` event.",
        "properties": {
          "message_id": {
            "title": "Message Id",
            "type": "string"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/Source"
            },
            "title": "Sources",
            "type": "array"
          }
        },
        "required": [
          "message_id",
          "sources"
        ],
        "title": "SourcesEvent",
        "type": "object"
      },
      "TextDelta": {
        "description": "One token of an assistant answer, as the ``delta`` SSE event's ``delta`` field.",
        "properties": {
          "text": {
            "title": "Text",
            "type": "string"
          },
          "type": {
            "const": "text",
            "default": "text",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "TextDelta",
        "type": "object"
      },
      "TextFragment": {
        "description": "One passage of a page, as the terms of a URL text fragment.\n\nA link to ``url#:~:text=start,end`` scrolls to and highlights the text\nfrom ``start`` through ``end``; to ``url#:~:text=start`` when ``end`` is\n``None``, the text ``start`` itself. The terms are plain text: a client\npercent-encodes them, including ``-``, ``,`` and ``&``, which the syntax\nreserves.",
        "properties": {
          "end": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "End"
          },
          "start": {
            "title": "Start",
            "type": "string"
          }
        },
        "required": [
          "start"
        ],
        "title": "TextFragment",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "FastRAG API",
    "version": "0.2.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "description": "Liveness and readiness.\n\nReturns ``200 {\"status\": \"ok\"}``. With a ``ChatStore`` entered, checks\nthe store's engine connection (``503`` when unreachable); the store's\nengine is the only one the app owns \u2014 it creates none itself.",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Healthz",
        "tags": [
          "health"
        ]
      }
    },
    "/metrics": {
      "get": {
        "description": "Build the ``GET /metrics`` response: ``401`` when a token is set and missing/wrong.\n\n``config.metrics_token`` compared with :func:`hmac.compare_digest`\nagainst the request's ``Authorization: Bearer <token>`` header \u2014 a\nmismatch or absent header is ``401`` with no metric text, exactly like\nevery other authentication failure in ``fastrag.serve``.",
        "operationId": "metrics_response_metrics_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Metrics Response"
      }
    },
    "/v1/chats": {
      "get": {
        "operationId": "list_chats_v1_chats_get",
        "parameters": [
          {
            "in": "query",
            "name": "before",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Before"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          },
          {
            "in": "cookie",
            "name": "session_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Session Id"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatListResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            },
            "description": "Missing or invalid session cookie/bearer token."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            },
            "description": "Chat or message not found."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            },
            "description": "A generation is already running for this chat."
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            },
            "description": "Request body too large."
          },
          "415": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            },
            "description": "Unsupported Content-Type."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            },
            "description": "Validation failed, or a configured cap was reached."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            },
            "description": "Rate limit exceeded."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            },
            "description": "Unhandled server error."
          }
        },
        "summary": "List Chats",
        "tags": [
          "chats"
        ]
      },
      "post": {
        "description": "Create a chat and stream the first answer.\n\nThe only endpoint that doesn't require an existing session.",
        "operationId": "create_chat_v1_chats_post",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          },
          {
            "in": "cookie",
            "name": "session_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Session Id"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            },
            "description": "Missing or invalid session cookie/bearer token."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            },
            "description": "Chat or message not found."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            },
            "description": "A generation is already running for this chat."
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            },
            "description": "Request body too large."
          },
          "415": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            },
            "description": "Unsupported Content-Type."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            },
            "description": "Validation failed, or a configured cap was reached."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            },
            "description": "Rate limit exceeded."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            },
            "description": "Unhandled server error."
          }
        },
        "summary": "Create Chat",
        "tags": [
          "chats"
        ]
      }
    },

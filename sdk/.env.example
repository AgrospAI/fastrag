POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fastrag
# Host port published by Traefik's PostgreSQL TCP entry point.
POSTGRES_PORT=5433
FASTRAG_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/fastrag

FASTRAG_MILVUS_URI=http://localhost:19530
FASTRAG_EMBEDDING_MODEL=minishlab/potion-base-8M

FASTRAG_CHAT_BASE_URL=http://ollama.localhost/v1
FASTRAG_CHAT_MODEL=llama3.2:3b
FASTRAG_CHAT_API_KEY=ollama

OPENAI_BASE_URL=https://chat.agrospai.udl.cat/api/v1
OPENAI_VISION_MODEL=Qwen/Qwen3.6-27b

RERANK_BASE_URL=https://litellm.agrospai.udl.cat
COHERE_API_KEY=

FASTRAG_SERVE_HOST=127.0.0.1
FASTRAG_SERVE_PORT=8100
FASTRAG_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
FASTRAG_COOKIE_SECURE=false
FASTRAG_SESSION_TTL_DAYS=30
FASTRAG_GENERATION_TIMEOUT_S=600

FASTRAG_API_URL=http://127.0.0.1:8100

# Docker dependency configuration
# Host port published by Traefik's Milvus TCP entry point.
MILVUS_PORT=19530
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
ETCD_AUTO_COMPACTION_MODE=revision
ETCD_AUTO_COMPACTION_RETENTION=1000
ETCD_QUOTA_BACKEND_BYTES=4294967296
ETCD_SNAPSHOT_COUNT=50000
ETCD_ENDPOINTS=etcd:2379
MINIO_ADDRESS=minio:9000
MILVUS_URL=milvus:19530
OLLAMA_HOST=http://ollama:11434

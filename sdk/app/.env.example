FASTRAG_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/fastrag
FASTRAG_MILVUS_URI=http://localhost:19530

FASTRAG_CHAT_BASE_URL=http://ollama.localhost/v1
FASTRAG_CHAT_MODEL=llama3.2:3b
FASTRAG_CHAT_API_KEY=ollama

FASTRAG_ALLOWED_ORIGINS=http://localhost:4321

# Optional: guards GET /metrics with a bearer token. Unset leaves it
# unguarded, reasonable for a scrape target reachable only on the compose
# network.
# FASTRAG_METRICS_TOKEN=

FASTRAG_SERVE_PORT=8000
